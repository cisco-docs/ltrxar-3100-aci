{
    "fabricFuncP": {
        "attributes": {
            "dn": "uni/fabric/funcprof"
        },
        "children": [
            {%- set comma1 = joiner(",") %}
            {%- for pg in apic.fabric_policies.leaf_interface_policy_groups | default([]) %}{{ comma1() }}
            {% set policy_group_name = pg.name ~ defaults.apic.fabric_policies.leaf_interface_policy_groups.name_suffix %}
            {
                "fabricLePortPGrp": {
                    "attributes": {
                        "annotation": "orchestrator:aac",
                        "name": "{{ policy_group_name }}",
                        "dn": "uni/fabric/funcprof/leportgrp-{{ policy_group_name }}",
                        "descr": "{{ pg.description | default() }}"
                    },
                    "children": [
                        {% set comma2 = joiner(",") %}
                        {% if pg.link_level_policy is defined %}{{ comma2() }}
                        {% set link_level_policy_name = pg.link_level_policy ~ defaults.apic.fabric_policies.interface_policies.link_level_policies.name_suffix %}
                        {
                            "fabricRsFIfPol": {
                                "attributes": {
                                    "annotation": "",
                                    "tnFabricFIfPolName": "{{ link_level_policy_name }}"
                                }
                            }
                        },
                        {%- endif %}
                        {
                            "fabricRsMonIfFabricPol": {
                                "attributes": {
                                    "annotation": "",
                                    "tnMonFabricPolName": "default"
                                }
                            }
                        }
                    ]
                }

            }
            {%- endfor %}
        ]
    }
}
