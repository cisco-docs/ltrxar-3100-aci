                                                                                {%- if (not int.floating_svi | default(defaults.apic.tenants.l3outs.nodes.interfaces.floating_svi)) and (int.ip_shared_dhcp_relay | default(defaults.apic.tenants.l3outs.nodes.interfaces.ip_shared_dhcp_relay)) %}{{ comma5() }}
